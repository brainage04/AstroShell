{
  "name": "@brainage04/astro-shell",
  "version": "0.6.0",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/brainage04/AstroShell"
  },
  "scripts": {
    "check": "astro check",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "release:check": "npm run check && npm run lint && npm run format:check && npm test && npm run pack:check",
    "prepublishOnly": "npm run release:check",
    "publish:package": "npm publish --access public"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "!src/**/*.test.ts"
  ],
  "exports": {
    ".": {
      "types": "./src/integration.d.ts",
      "default": "./src/integration.mjs"
    },
    "./components/NotFoundPage.astro": "./src/components/NotFoundPage.astro",
    "./components/PageHeader.astro": "./src/components/PageHeader.astro",
    "./components/ProfileCard.astro": "./src/components/ProfileCard.astro",
    "./components/SiteFooter.astro": "./src/components/SiteFooter.astro",
    "./components/SiteHeader.astro": "./src/components/SiteHeader.astro",
    "./components/SiteLayout.astro": "./src/components/SiteLayout.astro",
    "./components/StatCard.astro": "./src/components/StatCard.astro",
    "./components/TerminalPanel.astro": "./src/components/TerminalPanel.astro",
    "./pages/404.astro": "./src/pages/404.astro",
    "./config": "./src/config.ts",
    "./navigation": "./src/lib/navigation.ts",
    "./withBase": "./src/lib/withBase.ts",
    "./global.css": "./src/styles/global.css",
    "./themes/rose.css": "./src/themes/rose.css",
    "./eslint": {
      "types": "./src/presets/eslint.d.ts",
      "default": "./src/presets/eslint.js"
    },
    "./prettier": {
      "types": "./src/presets/prettier.d.mts",
      "default": "./src/presets/prettier.mjs"
    },
    "./tsconfig.json": "./src/presets/tsconfig.json"
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "eslint-plugin-astro": "3.1.0",
    "prettier-plugin-astro": "0.14.1",
    "typescript-eslint": "8.69.0"
  },
  "peerDependencies": {
    "@webtui/css": "^0.1.9",
    "astro": "^7.1.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@webtui/css": "0.1.10",
    "astro": "7.3.1",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
