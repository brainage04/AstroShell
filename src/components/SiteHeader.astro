---
import type { NavItem } from '../config';
import { isNavItemActive } from '../lib/navigation';
import { withBase } from '../lib/withBase';

export type { NavItem } from '../config';

export interface Props {
  items: readonly NavItem[];
  pathname?: string;
  /** Shown before the links on wide screens. */
  brandLabel?: string;
  brandHref?: string;
  /** The title between the menu and theme buttons while the links are collapsed. */
  title: string;
}

const { items, pathname = Astro.url.pathname, brandLabel, brandHref = '/', title }: Props = Astro.props;
const links = items.map((item) => ({
  ...item,
  url: item.external ? item.href : withBase(item.href),
  active: isNavItemActive(item, pathname),
}));
---

<header class="site-header" data-site-header data-has-brand={brandLabel ? 'true' : undefined}>
  <div class="header-bar">
    <button
      class="icon-button menu-button"
      type="button"
      aria-label="Open menu"
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-controls="site-drawer"
    >
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
        <path d="M3 6h18M3 12h18M3 18h18" fill="none" stroke="currentColor" stroke-width="2"></path>
      </svg>
    </button>
    <a class="site-brand" href={withBase(brandHref)}>{brandLabel ?? title}</a>
    <nav class="nav-links" aria-label="Primary navigation">
      {
        links.map((link) => (
          <a
            href={link.url}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noreferrer' : undefined}
            aria-current={link.active ? 'page' : undefined}
            data-active={link.active ? 'true' : undefined}
          >
            {link.name}
          </a>
        ))
      }
    </nav>
    <button class="icon-button theme-toggle" type="button" aria-label="Dark theme" aria-pressed="false" hidden>
      <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
        <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="2"
        ></path>
      </svg>
      <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
        <rect x="8" y="8" width="8" height="8" fill="none" stroke="currentColor" stroke-width="2"></rect>
        <path
          d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3M4.6 4.6l2.1 2.1M17.3 17.3l2.1 2.1M4.6 19.4l2.1-2.1M17.3 6.7l2.1-2.1"
          stroke="currentColor"
          stroke-width="2"></path>
      </svg>
    </button>
  </div>
  <dialog class="site-drawer" id="site-drawer" aria-labelledby="site-drawer-title">
    <div class="drawer-head">
      <button class="icon-button drawer-close" type="button" aria-label="Close menu" autofocus>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
          <path d="M5 5l14 14M19 5L5 19" fill="none" stroke="currentColor" stroke-width="2"></path>
        </svg>
      </button>
      <span class="drawer-title" id="site-drawer-title">{title}</span>
    </div>
    <nav class="drawer-links" aria-label="Primary navigation">
      {
        links.map((link) => (
          <a
            href={link.url}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noreferrer' : undefined}
            aria-current={link.active ? 'page' : undefined}
            data-active={link.active ? 'true' : undefined}
          >
            {link.name}
          </a>
        ))
      }
    </nav>
  </dialog>
</header>

<script is:inline>
  // Phones always get the menu button. Wider screens show the links inline and fall back to the menu
  // button only when the centred links do not fit between the brand and the theme button. This runs
  // inline, right after the header is parsed, so the first paint already has the right layout. Without
  // script the links wrap inline at every width and the theme button stays hidden.
  (() => {
    const header = document.currentScript.previousElementSibling;
    const bar = header.querySelector('.header-bar');
    const links = header.querySelector('.nav-links');
    const brand = header.querySelector('.site-brand');
    const toggle = header.querySelector('.theme-toggle');
    const phone = matchMedia('(max-width: 40rem)');
    toggle.hidden = false;

    function layout() {
      header.classList.remove('is-collapsed');
      header.classList.add('is-measuring');
      const gap = parseFloat(getComputedStyle(bar).columnGap) || 0;
      const side = Math.max(brand.offsetWidth, toggle.offsetWidth) + gap;
      const fits = links.scrollWidth + 2 * side <= bar.clientWidth;
      header.classList.remove('is-measuring');
      header.classList.toggle('is-collapsed', phone.matches || !fits);
    }

    layout();
    addEventListener('resize', layout);
    phone.addEventListener('change', layout);
    document.fonts?.ready.then(layout);
  })();
</script>

<script>
  import { THEME_KEY, themeColorMetas } from '../lib/theme';

  const drawer = document.getElementById('site-drawer') as HTMLDialogElement;
  const openButton = document.querySelector<HTMLButtonElement>('.site-header .menu-button')!;

  openButton.addEventListener('click', () => {
    drawer.showModal();
    openButton.setAttribute('aria-expanded', 'true');
  });
  drawer.addEventListener('close', () => openButton.setAttribute('aria-expanded', 'false'));
  drawer.querySelector('.drawer-close')!.addEventListener('click', () => drawer.close());
  // The drawer fills its dialog box, so a click on the dialog outside that box landed on the backdrop.
  drawer.addEventListener('click', (event) => {
    const box = drawer.getBoundingClientRect();
    const inside =
      event.clientX >= box.left &&
      event.clientX <= box.right &&
      event.clientY >= box.top &&
      event.clientY <= box.bottom;
    if (!inside || (event.target as Element).closest('a')) drawer.close();
  });
  // A page restored from the back/forward cache must not come back with the drawer open.
  addEventListener('pageshow', () => drawer.close());

  // Theme: the page follows the system until the visitor presses the toggle. The pick is kept in
  // localStorage and restored before the first paint by the inline script in SiteLayout.
  const root = document.documentElement;
  const systemDark = matchMedia('(prefers-color-scheme: dark)');
  const toggle = document.querySelector<HTMLButtonElement>('.site-header .theme-toggle')!;
  const effectiveTheme = () => root.dataset.theme ?? (systemDark.matches ? 'dark' : 'light');
  const syncToggle = () => toggle.setAttribute('aria-pressed', String(effectiveTheme() === 'dark'));

  toggle.addEventListener('click', () => {
    const next = effectiveTheme() === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem(THEME_KEY, next);
    } catch {
      // Storage blocked: the pick lasts for this page only.
    }
    themeColorMetas(next);
    syncToggle();
  });
  systemDark.addEventListener('change', syncToggle);
  syncToggle();
</script>

<style>
  .site-header {
    --header-gap: 0.75rem;
    position: sticky;
    inset-block-start: 0;
    z-index: 5;
    background: color-mix(in srgb, var(--background0) 90%, transparent);
    backdrop-filter: blur(12px);
    border-block-end: 1px solid color-mix(in srgb, var(--foreground2) 45%, transparent);
  }

  /* Wide screens: brand (when set) on the left, links in the middle, theme button on the right. */
  .header-bar {
    width: min(100% - 2 * var(--header-gap), var(--site-nav-width));
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 1.5rem;
    padding-block: clamp(0.65rem, 1.4vw, 0.85rem);
  }

  .icon-button {
    display: inline-grid;
    place-items: center;
    inline-size: var(--control-height);
    /* WebTUI gives every button a fixed 3lh height. */
    block-size: var(--control-height);
    padding: 0;
    border: 1px solid var(--control-border);
    background: var(--control-bg);
    color: var(--foreground0);
    cursor: pointer;
  }

  .icon-button:hover {
    border-color: var(--accent-primary);
  }

  .icon-button:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }

  .menu-button {
    display: none;
  }

  .site-brand {
    grid-column: 1;
    justify-self: start;
    min-width: 0;
    color: var(--accent-primary);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-header:not([data-has-brand]):not(.is-collapsed) .site-brand {
    display: none;
  }

  .site-header:not(.is-collapsed) .site-brand::before {
    content: '> ';
    color: var(--foreground2);
  }

  .site-brand:hover {
    color: var(--foreground0);
  }

  .nav-links {
    grid-column: 2;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem clamp(1.55rem, 4vw, 2.7rem);
    align-items: center;
  }

  .nav-links a {
    color: var(--foreground1);
    text-decoration: none;
    border-block-end: 2px solid transparent;
    padding-block: 0.2rem;
    transition:
      color 150ms ease,
      border-color 150ms ease;
  }

  .nav-links a:hover,
  .nav-links a[data-active='true'] {
    color: var(--foreground0);
    border-block-end-color: var(--accent-primary);
  }

  .theme-toggle {
    grid-column: 3;
    justify-self: end;
  }

  .theme-toggle[hidden] {
    display: none;
  }

  /* The icon shows the current theme: a moon in dark, a sun in light. */
  .theme-toggle .icon-moon,
  :root[data-theme='dark'] .theme-toggle .icon-sun {
    display: none;
  }

  :root[data-theme='dark'] .theme-toggle .icon-moon {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .theme-toggle .icon-moon {
      display: block;
    }

    :root:not([data-theme='light']) .theme-toggle .icon-sun {
      display: none;
    }
  }

  /* Measuring: one unbroken row, so links that do not fit show up as an overflowing bar. */
  .is-measuring .header-bar {
    grid-template-columns: auto auto auto;
  }

  .is-measuring .nav-links {
    flex-wrap: nowrap;
  }

  .is-measuring .nav-links a {
    white-space: nowrap;
    transition: none;
  }

  /* Collapsed: menu button on the left, title in the middle, theme button on the right. Each button is as
     far from the top of the header as from its side of the screen. */
  .is-collapsed .header-bar {
    width: auto;
    grid-template-columns: var(--control-height) minmax(0, 1fr) var(--control-height);
    gap: 0.5rem;
    padding: var(--header-gap);
  }

  .is-collapsed .menu-button {
    display: inline-grid;
    grid-column: 1;
  }

  .is-collapsed .site-brand {
    grid-column: 2;
    justify-self: center;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: 0.95rem;
  }

  .is-collapsed .nav-links {
    display: none;
  }

  /* The drawer: full height, about two thirds of a phone's width, sliding in from the left. */
  .site-drawer {
    inset: 0 auto 0 0;
    inline-size: min(66.667vw, 24rem);
    max-inline-size: none;
    block-size: auto;
    max-block-size: none;
    margin: 0;
    padding: 0;
    overflow-y: auto;
    border: 0;
    border-inline-end: 1px solid var(--panel-border);
    background: var(--background1);
    color: var(--foreground0);
    box-shadow: var(--shadow-raised);
    translate: -100% 0;
    transition:
      translate 220ms ease,
      overlay 220ms ease allow-discrete,
      display 220ms ease allow-discrete;
  }

  .site-drawer[open] {
    translate: 0 0;
  }

  .site-drawer::backdrop {
    background: rgb(0 0 0 / 0%);
    transition:
      background-color 220ms ease,
      overlay 220ms ease allow-discrete,
      display 220ms ease allow-discrete;
  }

  .site-drawer[open]::backdrop {
    background: rgb(0 0 0 / 55%);
  }

  @starting-style {
    .site-drawer[open] {
      translate: -100% 0;
    }

    .site-drawer[open]::backdrop {
      background: rgb(0 0 0 / 0%);
    }
  }

  /* Close button on the left. The title is centred in the rest of the head, from the button's right edge to
     the drawer's right edge, and centred vertically on its capital letters (text-box) against the button. */
  .drawer-head {
    display: grid;
    grid-template-columns: var(--control-height) minmax(0, 1fr);
    align-items: center;
    padding: var(--header-gap) 0 var(--header-gap) var(--header-gap);
    border-block-end: 1px solid var(--panel-border);
  }

  .drawer-title {
    padding-inline: var(--header-gap);
    /* clip, not hidden: the trimmed box is only cap-height tall, so ascenders and descenders must stay visible. */
    overflow-x: clip;
    color: var(--accent-primary);
    font-weight: 700;
    text-align: center;
    text-box: trim-both cap alphabetic;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .drawer-links {
    display: grid;
    padding: 0.5rem 0;
  }

  .drawer-links a {
    display: flex;
    align-items: center;
    min-height: var(--control-height);
    padding: 0.5rem var(--header-gap);
    overflow-wrap: anywhere;
    border-inline-start: 3px solid transparent;
    color: var(--foreground1);
    text-decoration: none;
  }

  .drawer-links a:hover,
  .drawer-links a[data-active='true'] {
    color: var(--foreground0);
    background: var(--background2);
  }

  .drawer-links a[data-active='true'] {
    border-inline-start-color: var(--accent-primary);
  }
</style>

<style is:global>
  /* The page behind the open drawer does not scroll. */
  html:has(#site-drawer[open]) {
    overflow: hidden;
  }
</style>
