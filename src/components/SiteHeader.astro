---
import type { NavItem } from '../config';
import { isNavItemActive } from '../lib/navigation';
import { withBase } from '../lib/withBase';

export type { NavItem } from '../config';

export interface Props {
  items: readonly NavItem[];
  pathname?: string;
  brandLabel?: string;
  brandHref?: string;
}

const { items, pathname = Astro.url.pathname, brandLabel, brandHref = '/' }: Props = Astro.props;
---

<header class="site-header" data-site-header>
  <nav aria-label="Primary navigation" data-has-brand={brandLabel ? 'true' : undefined}>
    {
      brandLabel && (
        <a class="site-brand" href={withBase(brandHref)}>
          {brandLabel}
        </a>
      )
    }
    <button class="menu-button" type="button" popovertarget="site-menu" aria-controls="site-menu">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
        <path d="M3 6h18M3 12h18M3 18h18" fill="none" stroke="currentColor" stroke-width="2"></path>
      </svg>
      <span>Menu</span>
    </button>
    <div class="nav-links" id="site-menu" popover="auto">
      {
        items.map((item) => {
          const active = isNavItemActive(item, pathname);
          return (
            <a
              href={item.external ? item.href : withBase(item.href)}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noreferrer' : undefined}
              aria-current={active ? 'page' : undefined}
              data-active={active ? 'true' : undefined}
            >
              {item.name}
            </a>
          );
        })
      }
    </div>
  </nav>
</header>

<script is:inline>
  // Phones always get the menu button. Wider screens show the links inline and fall back to the menu
  // button only when the links do not fit on one row. The links are a popover only while collapsed, so
  // the inline row stays a plain group of links. This runs inline, right after the header is parsed, so
  // the first paint already has the right layout. Without script the links wrap inline at every width.
  (() => {
    const header = document.currentScript.previousElementSibling;
    const nav = header.querySelector('nav');
    const menu = header.querySelector('#site-menu');
    const phone = matchMedia('(max-width: 40rem)');

    function layout() {
      const wasOpen = menu.matches(':popover-open');
      header.classList.remove('is-collapsed');
      header.classList.add('is-measuring');
      const fits = nav.scrollWidth <= nav.clientWidth;
      header.classList.remove('is-measuring');
      const collapsed = phone.matches || !fits;
      header.classList.toggle('is-collapsed', collapsed);
      if (collapsed) {
        menu.setAttribute('popover', 'auto');
        if (wasOpen) menu.showPopover();
      } else {
        menu.removeAttribute('popover');
      }
    }

    layout();
    addEventListener('resize', layout);
    phone.addEventListener('change', layout);
    document.fonts?.ready.then(layout);
  })();
</script>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 5;
    background: color-mix(in srgb, var(--background0) 90%, transparent);
    backdrop-filter: blur(12px);
    border-block-end: 1px solid color-mix(in srgb, var(--foreground2) 45%, transparent);
  }

  nav {
    width: min(100% - 1.5rem, var(--site-nav-width));
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding-block: clamp(0.65rem, 1.4vw, 0.85rem);
  }

  nav[data-has-brand='true'] {
    justify-content: space-between;
  }

  .site-brand {
    color: var(--accent-primary);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-brand::before {
    content: '> ';
    color: var(--foreground2);
  }

  .site-brand:hover {
    color: var(--foreground0);
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem clamp(1.55rem, 4vw, 2.7rem);
    align-items: center;
  }

  .nav-links a {
    color: var(--foreground1);
    text-decoration: none;
    border-block-end: 2px solid transparent;
    padding-block: 0.2rem;
    transition:
      color 150ms ease,
      border-color 150ms ease;
  }

  .nav-links a:hover,
  .nav-links a[data-active='true'] {
    color: var(--foreground0);
    border-block-end-color: var(--accent-primary);
  }

  .menu-button {
    display: none;
    gap: 0.5rem;
    /* WebTUI gives every button a fixed 3lh height. */
    height: auto;
    min-height: var(--control-height);
    margin-inline-start: auto;
    padding: 0 0.85rem;
    border: 1px solid var(--control-border);
    background: var(--control-bg);
    color: var(--foreground0);
    font: inherit;
    cursor: pointer;
  }

  .menu-button:hover {
    border-color: var(--accent-primary);
  }

  /* Measuring: one unbroken row, so an overflow shows up as scrollWidth. */
  .is-measuring .nav-links {
    flex-wrap: nowrap;
  }

  .is-measuring .nav-links a {
    white-space: nowrap;
    transition: none;
  }

  /* Collapsed: the menu button opens the links as a popover under the header. */
  .is-collapsed .menu-button {
    display: inline-flex;
    align-items: center;
  }

  .is-collapsed nav {
    justify-content: space-between;
    padding-block: 0.4rem;
  }

  .is-collapsed .nav-links {
    position: fixed;
    inset: auto;
    /* Below the header; browsers with anchor positioning attach it to the button instead. */
    inset-block-start: 3.75rem;
    inset-block-start: anchor(--menu-button bottom);
    inset-inline-end: 0.75rem;
    inline-size: min(18rem, 100dvw - 1.5rem);
    max-block-size: calc(100dvh - 5rem);
    margin: 0.4rem 0 0;
    overflow: auto;
    flex-direction: column;
    flex-wrap: nowrap;
    align-items: stretch;
    gap: 0;
    padding: 0.35rem;
    border: 1px solid var(--panel-border);
    background: var(--background1);
    color: var(--foreground0);
    box-shadow: var(--shadow-raised);
  }

  .is-collapsed .menu-button {
    anchor-name: --menu-button;
  }

  .is-collapsed .nav-links a {
    display: flex;
    align-items: center;
    min-height: var(--control-height);
    padding: 0 0.75rem;
    border-block-end: 0;
    border-inline-start: 2px solid transparent;
  }

  .is-collapsed .nav-links a[data-active='true'] {
    border-inline-start-color: var(--accent-primary);
  }

  .is-collapsed .nav-links:not(:popover-open) {
    display: none;
  }

  /* Without script the popover attribute stays in the markup: keep the links an inline row. */
  .site-header:not(.is-collapsed) .nav-links[popover] {
    position: static;
    inset: auto;
    inline-size: auto;
    block-size: auto;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: visible;
    background: transparent;
    color: inherit;
  }
</style>
