---
import config from 'virtual:astro-shell/config';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';
import { withBase } from '../lib/withBase';
import '../styles/global.css';
import 'virtual:astro-shell/styles';

export interface Props {
  /** Omit on the home page: the document title becomes `homeTitle` (or `siteName`). */
  title?: string;
  description?: string;
  image?: string;
  ogType?: 'website' | 'article';
  canonicalHref?: string;
}

const {
  siteName,
  navItems,
  sourceHref,
  homeTitle = siteName,
  brandLabel,
  brandHref,
  faviconHref,
  faviconType,
  themeColor = '#151515',
  preconnectHrefs = [],
  ownerHref,
  ownerName,
  creatorHref,
  creatorName,
  year,
  lang = 'en',
} = config;
const {
  title,
  description = config.description,
  image = config.image,
  ogType = 'website',
  canonicalHref = config.canonicalHref,
} = Astro.props;
const pageTitle = title === undefined ? homeTitle : `${title} | ${siteName}`;
const canonicalUrl = canonicalHref
  ? new URL(withBase(canonicalHref), Astro.site ?? Astro.url.origin).toString()
  : Astro.site
    ? new URL(Astro.url.pathname, Astro.site).toString()
    : undefined;
const imageUrl = image ? new URL(withBase(image), Astro.site ?? Astro.url.origin).toString() : undefined;
// Prefetch same-origin pages as the visitor shows interest in them; browsers without Speculation Rules ignore it.
const speculationRules = JSON.stringify({
  prefetch: [{ where: { href_matches: '/*' }, eagerness: 'moderate' }],
});
---

<!doctype html>
<html lang={lang} data-webtui-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content={themeColor} />
    {description && <meta name="description" content={description} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    {description && <meta name="twitter:description" content={description} />}
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {faviconHref && <link rel="icon" type={faviconType} href={withBase(faviconHref)} />}
    {preconnectHrefs.map((href) => <link rel="preconnect" href={href} />)}
    <title>{pageTitle}</title>
    <script type="speculationrules" is:inline set:html={speculationRules} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader items={navItems} pathname={Astro.url.pathname} brandLabel={brandLabel} brandHref={brandHref} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter
      sourceHref={sourceHref}
      ownerHref={ownerHref}
      ownerName={ownerName}
      creatorHref={creatorHref}
      creatorName={creatorName}
      year={year}
    />
  </body>
</html>
