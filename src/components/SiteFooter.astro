---
export interface Props {
  sourceHref: string;
  ownerHref?: string;
  ownerName?: string;
  creatorHref?: string;
  creatorName?: string;
  year?: number;
}

const {
  sourceHref,
  ownerHref = 'https://github.com/brainage04',
  ownerName = 'brainage04',
  creatorHref,
  creatorName,
  year = new Date().getFullYear(),
} = Astro.props;
---

<footer class="site-footer">
  <div class="footer-inner">
    <span class="footer-owner">© {year} <a href={ownerHref} target="_blank" rel="noreferrer">{ownerName}</a></span>
    <span class="footer-credit">
      Made with <a href="https://astro.build/" target="_blank" rel="noreferrer">Astro</a> + <a
        href="https://webtui.ironclad.sh/"
        target="_blank"
        rel="noreferrer">WebTUI</a
      >
      {
        creatorHref && creatorName && (
          <>
            {' '}
            by{' '}
            <a href={creatorHref} target="_blank" rel="noreferrer">
              {creatorName}
            </a>
          </>
        )
      }
    </span>
    <a class="footer-source" href={sourceHref} target="_blank" rel="noreferrer">Source code</a>
  </div>
</footer>

<style>
  .site-footer {
    border-block-start: 1px solid var(--foreground2);
    color: var(--foreground2);
  }

  .footer-inner {
    width: min(100% - 1rem, var(--site-footer-width, 72rem));
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 0.5rem 1rem;
    padding-block: 1rem;
  }

  .footer-owner {
    justify-self: start;
  }

  .footer-credit {
    justify-self: center;
    text-align: center;
  }

  .footer-source {
    justify-self: end;
  }

  a {
    color: var(--foreground1);
    text-underline-offset: 0.18em;
  }

  a:hover {
    color: var(--accent-cyan);
  }
  @media (max-width: 700px) {
    .footer-inner {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }

    .footer-owner,
    .footer-credit,
    .footer-source {
      justify-self: center;
    }
  }
</style>
