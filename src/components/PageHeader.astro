---
export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<header class="page-header">
  <h1>{title}</h1>
</header>

<style>
  h1 {
    margin: 0;
    font-size: clamp(2.2rem, 7vw, 4.35rem);
    line-height: 0.95;
    letter-spacing: -0.055em;
    max-width: 14ch;
    text-shadow: 0 0 2rem color-mix(in srgb, var(--accent-cyan) 16%, transparent);
  }

</style>
